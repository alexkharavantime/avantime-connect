<Window x:Class="AvantimeConnect.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Avantime Connect" Width="680" Height="690" MinWidth="540" MinHeight="620"
 WindowStartupLocation="CenterScreen" Background="#F4F7FA" Loaded="Window_Loaded">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="32">
   <TextBlock Text="Avantime Connect" FontSize="30" FontWeight="SemiBold" Foreground="#16334B"/>
   <TextBlock Text="Регистрация компьютера" FontSize="19" Margin="0,8,0,24"/>
   <Border Background="White" CornerRadius="12" Padding="24" BorderBrush="#DCE4EC" BorderThickness="1">
    <StackPanel>
     <TextBlock Text="Адрес сервера" Margin="0,0,0,6"/>
     <TextBox x:Name="ApiOrigin" AutomationProperties.Name="Адрес сервера"/>
     <TextBlock Text="Адрес выдаёт администратор. Для проверки через SSH можно использовать http://127.0.0.1:15173."
       TextWrapping="Wrap" Foreground="#536575" Margin="0,6,0,16"/>
     <TextBlock Text="Имя компьютера" Margin="0,0,0,6"/>
     <TextBox x:Name="DeviceName" MaxLength="128" AutomationProperties.Name="Имя компьютера"/>
     <TextBlock Text="Приглашение" Margin="0,16,0,6"/>
     <PasswordBox x:Name="Invitation" Padding="9" FontSize="15" MaxLength="4096" AutomationProperties.Name="Приглашение"/>
     <TextBlock Text="Вставьте токен приглашения для этого устройства. Ключ администратора здесь не используется."
       TextWrapping="Wrap" Foreground="#536575" Margin="0,6,0,20"/>
     <Button x:Name="Register" Content="Зарегистрировать компьютер" Click="Register_Click"
       Background="#1764A0" Foreground="White" HorizontalAlignment="Left"/>
    </StackPanel>
   </Border>
   <TextBlock x:Name="Status" Text="Готов к регистрации." TextWrapping="Wrap" FontSize="15" Margin="0,20,0,12"/>
   <TextBlock Text="Первый этап: получение и защищённое сохранение профиля. Подключение VPN и запуск рабочего стола будут добавлены следующим этапом."
       TextWrapping="Wrap" Foreground="#536575"/>
  </StackPanel>
 </ScrollViewer>
</Window>
