<Window x:Class="AvantimeConnect.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Avantime Connect" Width="720" Height="820" MinWidth="540" MinHeight="620"
 WindowStartupLocation="CenterScreen" Background="#F4F7FA" Loaded="Window_Loaded">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="32">
   <TextBlock Text="Avantime Connect" FontSize="30" FontWeight="SemiBold" Foreground="#16334B"/>
   <TextBlock Text="Компьютер и VPN" FontSize="19" Margin="0,8,0,24"/>
   <Border x:Name="RegistrationPanel" Background="White" CornerRadius="12" Padding="24" BorderBrush="#DCE4EC" BorderThickness="1">
    <StackPanel>
     <TextBlock Text="Адрес сервера" Margin="0,0,0,6"/>
     <TextBox x:Name="ApiOrigin" Text="https://connect.avantime.lv" AutomationProperties.Name="Адрес сервера"/>
     <TextBlock Text="Адрес выдаёт администратор. Для проверки через SSH можно использовать http://127.0.0.1:15173."
       TextWrapping="Wrap" Foreground="#536575" Margin="0,6,0,16"/>
     <TextBlock Text="Имя компьютера" Margin="0,0,0,6"/>
     <TextBox x:Name="DeviceName" MaxLength="128" AutomationProperties.Name="Имя компьютера"/>
     <TextBlock Text="Приглашение" Margin="0,16,0,6"/>
     <PasswordBox x:Name="Invitation" Padding="9" FontSize="15" MaxLength="4096" AutomationProperties.Name="Приглашение"/>
     <TextBlock Text="Вставьте токен приглашения для этого устройства. Ключ администратора здесь не используется."
       TextWrapping="Wrap" Foreground="#536575" Margin="0,6,0,20"/>
     <Button x:Name="Register" Content="Зарегистрировать компьютер" Click="Register_Click"
       Background="#1764A0" Foreground="White" HorizontalAlignment="Left"/>
    </StackPanel>
   </Border>
   <TextBlock x:Name="Status" Text="Готов к регистрации." TextWrapping="Wrap" FontSize="15" Margin="0,20,0,12"/>
   <Border x:Name="TunnelPanel" Visibility="Collapsed" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
    <StackPanel>
     <TextBlock Text="VPN" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="Подключение к разрешённым рабочим серверам. Управление выполняет служба Avantime Connect."
       TextWrapping="Wrap" Foreground="#536575" Margin="0,8,0,12"/>
     <WrapPanel>
      <Button x:Name="ConnectVpn" Width="176" Height="44" Content="Подключить VPN" Tag="connect" Click="Tunnel_Click" Background="#1764A0" Foreground="White" Margin="0,0,8,8"/>
      <Button x:Name="DisconnectVpn" Width="176" Height="44" Content="Отключить VPN" Tag="disconnect" Click="Tunnel_Click" Margin="0,0,8,8"/>
      <Button x:Name="CheckVpn" Width="176" Height="44" Content="Проверить VPN" Tag="check" Click="Tunnel_Click" Margin="0,0,0,8"/>
     </WrapPanel>
     <TextBlock x:Name="VpnStatus" Text="Состояние VPN ещё не проверено." TextWrapping="Wrap" Margin="0,8,0,12"/>
     <TextBlock Text="Закрытие окна не отключает VPN. Для завершения соединения нажмите «Отключить VPN». После успешной настройки автоматический запуск при включении Windows отключён."
       TextWrapping="Wrap" Foreground="#536575"/>
    </StackPanel>
   </Border>
   <Border x:Name="DesktopPanel" Visibility="Collapsed" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
    <StackPanel>
     <TextBlock Text="Рабочий стол" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <WrapPanel>
      <Button x:Name="OpenDev" Content="Открыть DEV" IsEnabled="False" Click="OpenProd_Click" Tag="dev"
        Width="176" Height="44" Background="#1764A0" Foreground="White" Margin="0,0,8,8"/>
      <Button x:Name="OpenProd" Tag="prod" Content="Открыть PROD" IsEnabled="False" Click="OpenProd_Click"
        Width="176" Height="44" Background="#1764A0" Foreground="White" Margin="0,0,8,8"/>
     </WrapPanel>
     <StackPanel x:Name="RemoteAppPanel" Visibility="Collapsed" Margin="0,4,0,8">
      <Button x:Name="OpenRemoteApp" Content="Открыть RemoteApp…" Click="OpenRemoteApp_Click"
        Width="200" Height="44" HorizontalAlignment="Left" IsEnabled="False"/>
      <TextBlock Text="Выберите файл .rdp, выданный администратором для PROD. Перед запуском проверяются VPN, DNS и доступ к серверу."
        TextWrapping="Wrap" Foreground="#536575" Margin="0,8,0,0"/>
     </StackPanel>
     <Border BorderBrush="#DCE4EC" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,4,0,0">
      <StackPanel>
       <Button x:Name="RefreshAccess" Content="Обновить доступ" Click="RefreshAccess_Click"
         Width="176" Height="44" HorizontalAlignment="Left"/>
       <TextBlock Text="После изменения прав администратором отключите VPN и обновите доступ."
         TextWrapping="Wrap" Foreground="#536575" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
     <TextBlock x:Name="DesktopStatus" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
   <TextBlock Text="DEV: WIN-APP-DEV, 10.20.0.20. PROD: 10.40.0.20. Доступ назначает администратор. RemoteApp: опубликованный файл для WIN-APP-PROD.AD.AVANTIME.LV."
       TextWrapping="Wrap" Foreground="#536575"/>
  </StackPanel>
 </ScrollViewer>
</Window>
